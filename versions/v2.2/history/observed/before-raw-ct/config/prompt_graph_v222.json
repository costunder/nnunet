  "cp_probability": 0.8,
  "donor_max_diameter_mm": 20.0,
  "diameter_definition": "volume_equivalent_sphere_as_in_preserved_donor_contract",
  "blind_policy": "one_radius_fitted_from_all_inner_train_small_lesion_extents_plus_existing_2mm_margin",
