{
  "format": "hiercp_v222_v1_local_cluster_r5",
  "release": "v2.22",
  "base_config": "config/train.json",
  "seed": 42,
  "label_count": 2,
  "label_definition": [
    "no_tumor_observed_at_comparison_center",
    "small_tumor_observed_at_anchor"
  ],
  "label_count_rationale": "User-approved explicit observation task; not a speed-driven latent capacity reduction.",
  "task_layers": 2,
  "alignment_layers": 2,
  "temperature": 0.2,
  "gnn_epochs": 40,
  "nnunet_epochs": 250,
  "candidate_count": 128,
  "comparison_centers_per_patient": 128,
  "comparison_center_rule": "annotated_liver_center_excluding_exact_positive_anchors_v1",
  "comparison_count_rationale": "Reuse full 128-position candidate budget per patient and retain every eligible positive anchor.",
  "cp_probability": 0.8,
  "donor_max_diameter_mm": 20,
  "diameter_definition": "volume_equivalent_sphere_as_in_preserved_donor_contract",
  "input_policy": "raw_CT_donor_recipient_v1_physical_context_graph",
  "graph_sampling": {
    "method": "v1_physical_radius_context_seed_hop_closure",
    "source": "config/train.json:graph",
    "no_ppr": true,
    "no_astar": true
  },
  "outer_field_policy": "v1_adaptive_native_ROI_full_donor_shape_and_existing_context_margin",
  "score_interpretation": "experimental_observation_similarity_ranking_not_validated_placement_probability",
  "support_policy": "inner_train_pairs_excluding_query_group_on_recipient_and_donor_sides",
  "memory_refresh": "all_inner_train_CNN_embeddings_each_epoch_detached_query_encoder_receives_gradients",
  "selection": "aligned_observation_context_argmax",
  "alignment_target": "other_patient_class_conditional_prototypes_query_CE_plus_alignment_CE",
  "cluster_method": "cosine_average_linkage",
  "cluster_selection": "maximum_positive_silhouette_all_non_singleton_cuts_else_one",
  "cluster_refresh": "detached_eval_L1_once_per_query_patient_episode",
  "cluster_min_patients_per_submode": 2,
  "cluster_min_patients_rationale": "A discovered cross-patient submode needs evidence from at least two distinct support patients; this does not drop patients or graph nodes.",
  "alignment_loss_weight": 1,
  "alignment_loss_weight_rationale": "Equal-weight mean CE objectives as an explicit unvalidated starting design; requires ablation, not copied from SwAV.",
  "prototype_score": "patient_mass_weighted_logsumexp_within_observation_class",
  "donor_policy": "shared_inner_train_donors_uniform_per_cp_event_v1",
  "batch_size": "auto",
  "num_workers": "auto",
  "worker_candidates": [
    0,
    2,
    4,
    8
  ],
  "preparation_workers": "auto",
  "batch_calibration_repeats": 3,
  "max_vram_fraction": 0.9,
  "gradient_accumulation": 1,
  "minimum_free_gb": 80,
  "local_encoder": "v1_ct_only_context_pair",
  "implementation_scope": "paired_L0_L1_L2_full_cohort_training_and_candidate_scoring",
  "paired_gnn_training_ready": true,
  "production_training_ready": false,
  "production_limitation": "Paired GNN has a dedicated cache/training runner. Native online bank/nnU-Net integration is not complete; old recipient-only caches/checkpoints cannot be relabeled."
}
