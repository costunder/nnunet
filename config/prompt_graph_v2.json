{
  "format": "hiercp_prompt_graph_v2_cross_patient_r1",
  "seed": 42,
  "base_config": "config/train.json",
  "local_encoder": "v1_full_scale_kdtree_gated_attention",
  "task_layers": 2,
  "alignment_layers": 2,
  "label_count": 16,
  "label_definition": "independent_patient_random_trainable_latent_nodes",
  "label_count_rationale": "Retain the existing 16-category capacity as an explicit experimental budget, not anatomical truth; all patients and all eligible source graphs are used.",
  "task_definition": "actual_patient_id",
  "support_policy": "all_actual_patient_contexts_cross_patient_T_only",
  "label_initialization": "independent_seeded_random_trainable",
  "alignment_target": "cross_patient_context_correspondence_and_positive_transfer",
  "evidence_contract": "T_observed_F_geometrically_impossible_U_unobserved",
  "temperature": 0.2,
  "loss_weights": {"observed_transfer": 1.0, "context_reconstruction": 1.0, "cross_patient_alignment": 1.0},
  "gnn_epochs": 40,
  "nnunet_epochs": 250,
  "candidate_count": 128,
  "donor_policy": "shared_inner_train_donors_uniform_per_cp_event_v1",
  "gnn_context_schedule": "balanced_complete_donor_round_per_partition_v1",
  "cp_probability": 0.5,
  "donor_max_diameter_mm": 20.0,
  "selection": "cross_patient_positive_transport_argmax",
  "training_device": "cuda",
  "batch_size": "auto",
  "batch_calibration_repeats": 3,
  "max_vram_fraction": 0.9,
  "num_workers": "auto",
  "worker_candidates": [0, 2, 4, 8],
  "preparation_workers": "auto",
  "gradient_accumulation": 1,
  "minimum_free_gb": 80.0
}
