{
  "format": "nnunet_completed_result_layout_v1",
  "result_schema_version": 1,
  "kind": "declarative_report_layout_not_observed_results",
  "contract": "docs/nnunet_result_report_contract.txt",
  "template": "docs/nnunet_result_report_template.txt",
  "section_order": [
    "completion_and_best_provenance",
    "experiment_gnn_cp_settings",
    "nnunet_training_record",
    "whole_tumor_segmentation",
    "whole_lesion_detection",
    "size_stratified_detection",
    "basic_cp_comparison",
    "artifacts_verification_and_limitations"
  ],
  "tables": {
    "completion_and_best_provenance": ["experiment", "training_status", "completed_epochs", "planned_epochs", "best_native_evaluation_status", "predicted_cases", "expected_cases", "lesion_metrics_status", "comparison_status"],
    "nnunet_training_record": ["experiment", "planned_epochs", "completed_epochs", "best_current_epoch_raw", "best_selection_rule", "latest_loss_epoch", "train_loss", "val_loss", "online_pseudo_dice", "cp_applied", "cp_attempted", "cp_apply_rate", "training_seconds", "peak_vram_gib", "rss_gib", "measurement_scope"],
    "whole_tumor_segmentation": ["experiment", "checkpoint", "evaluation_cases", "case_macro_tumor_dice", "lesion_mean_dice", "native_liver_dice", "native_tumor_dice", "metric_source_and_aggregation"],
    "whole_lesion_detection": ["experiment", "criterion", "gt", "tp", "fp", "fn", "recall", "precision", "f1", "fp_per_case"],
    "size_stratified_detection": ["experiment", "criterion", "size_bin", "gt", "detected", "missed", "recall"],
    "basic_cp_comparison": ["experiment", "metric", "criterion", "size_bin", "basic_value", "experiment_value", "experiment_minus_basic", "ci95_low", "ci95_high", "patient_swap_p", "wilcoxon_p", "comparison_status", "evidence_or_unavailable_reason"]
  },
  "detection_criteria_order": ["legacy_any_overlap", "dice_ge_0p10", "dice_ge_0p25", "dice_ge_0p50", "gtcov_ge_0p10", "iou_ge_0p10"],
  "size_bins_order": ["le_10mm", "gt_10_le_20mm", "gt_20mm"],
  "small_lesion_definition": "GT 26-connectivity component volume equivalent spherical diameter <=10mm",
  "lesion_mean_dice_aggregation": "all_GT_lesion_weighted_mean_including_unmatched_zero",
  "donor_size_eligibility_is_a_separate_setting": true,
  "checkpoint_required_for_evaluation": "checkpoint_best.pth",
  "final_checkpoint_role": "training_completion_witness_only",
  "best_epoch_index": "preserve_raw_current_epoch_with_index_definition",
  "completion_scopes": ["full_training", "full_best_native_prediction_and_evaluation", "lesion_metric_publication", "matched_comparison_admission"],
  "status_values": ["NOT_STARTED", "RUNNING", "INCOMPLETE", "VERIFIED_COMPLETE", "UNVERIFIED", "FAILED"],
  "comparison_status_values": ["MATCHED_VERIFIED", "HISTORICAL_REFERENCE", "NOT_COMPARABLE", "PENDING_VERIFICATION"],
  "rendering": {
    "unknown_numeric_value": null,
    "unknown_display": "NA",
    "unavailable_reason_required": true,
    "remove_missing_rows_or_columns": false,
    "replace_unknown_with_zero": false,
    "ratio_scale": "0_to_1",
    "display_decimal_places": 4,
    "fp_per_case_display_decimal_places": 3,
    "preserve_original_json_csv_precision": true,
    "difference_direction": "experiment_minus_basic",
    "positive_improves": ["dice", "recall", "precision", "f1"],
    "negative_improves": ["fp_per_case"],
    "posthoc_primary_endpoint_selection": false
  },
  "metric_producer": "tools/online_eval_v2.py",
  "native_completion_evidence": ["training_complete_*.json", "best_validation_complete.json", "validation/summary.json"],
  "lesion_metric_completion_evidence": "completion.json_with_output_hashes",
  "existing_metric_artifact_names": ["summary.json", "comparison.md", "case_metrics.csv", "case_detection_metrics.csv", "lesion_detection_metrics.csv", "prediction_detection_metrics.csv", "criterion_summary.csv", "size_recall_summary.csv", "patient_cluster_statistics.csv", "evaluation_started.json", "completion.json"],
  "provenance_fields": ["evaluator_version", "evaluator_source_sha256", "evaluation_contract_sha256", "completion_sha256", "ground_truth_identity", "prediction_identity", "cohort_identity", "prediction_origin_status_raw", "own_best_witness_status", "basic_best_witness_status"],
  "preserve_native_training_logger": true,
  "modify_metric_math": false,
  "overwrite_existing_results": false,
  "automatic_execution_claim": "layout_only_does_not_register_a_new_metric_job"
}
